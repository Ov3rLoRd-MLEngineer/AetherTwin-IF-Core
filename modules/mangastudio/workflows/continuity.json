{
  "1": {"class_type": "CheckpointLoaderSimple", "_meta": {"title": "Modèle SDXL anime (à choisir)"},
        "inputs": {"ckpt_name": "A_CHOISIR_sdxl_anime.safetensors"}},
  "2": {"class_type": "LoadImage", "_meta": {"title": "Référence du personnage (case précédente)"},
        "inputs": {"image": "reference_personnage.png"}},
  "3": {"class_type": "LoadImage", "_meta": {"title": "Trait ou pose de la nouvelle case"},
        "inputs": {"image": "controle_nouvelle_case.png"}},
  "4": {"class_type": "IPAdapterUnifiedLoader", "_meta": {"title": "IP-Adapter : identité du personnage"},
        "inputs": {"model": ["1", 0], "preset": "PLUS (high strength)"}},
  "5": {"class_type": "IPAdapter", "_meta": {"title": "Appliquer l'identité"},
        "inputs": {"model": ["4", 0], "ipadapter": ["4", 1], "image": ["2", 0], "weight": 0.8,
                   "start_at": 0.0, "end_at": 1.0, "weight_type": "standard"}},
  "6": {"class_type": "CLIPTextEncode", "_meta": {"title": "Prompt positif"},
        "inputs": {"clip": ["1", 1], "text": "1girl, manga panel, same character, consistent outfit, clean lineart"}},
  "7": {"class_type": "CLIPTextEncode", "_meta": {"title": "Prompt négatif"},
        "inputs": {"clip": ["1", 1], "text": "bad hands, extra fingers, deformed feet, blurry, lowres"}},
  "8": {"class_type": "ControlNetLoader", "_meta": {"title": "ControlNet SDXL (trait ou pose, à choisir)"},
        "inputs": {"control_net_name": "A_CHOISIR_controlnet_sdxl_lineart.safetensors"}},
  "9": {"class_type": "ControlNetApplyAdvanced", "_meta": {"title": "Suivre le trait de la nouvelle case"},
        "inputs": {"positive": ["6", 0], "negative": ["7", 0], "control_net": ["8", 0], "image": ["3", 0],
                   "strength": 0.75, "start_percent": 0.0, "end_percent": 0.85}},
  "10": {"class_type": "EmptyLatentImage", "_meta": {"title": "Taille de la case"},
         "inputs": {"width": 1024, "height": 1280, "batch_size": 1}},
  "11": {"class_type": "KSampler", "_meta": {"title": "Génération"},
         "inputs": {"model": ["5", 0], "positive": ["9", 0], "negative": ["9", 1], "latent_image": ["10", 0],
                    "seed": 20261125, "steps": 28, "cfg": 6.0, "sampler_name": "euler_ancestral",
                    "scheduler": "normal", "denoise": 1.0}},
  "12": {"class_type": "VAEDecode", "_meta": {"title": "Décodage"},
         "inputs": {"samples": ["11", 0], "vae": ["1", 2]}},
  "13": {"class_type": "AetherTwinHandSegNet", "_meta": {"title": "Contrôle : masque des mains (HandSegNet)"},
         "inputs": {"image": ["12", 0], "x1": 0, "y1": 0, "x2": 1024, "y2": 1280, "weights_path": ""}},
  "14": {"class_type": "SaveImage", "_meta": {"title": "Case générée"},
         "inputs": {"images": ["12", 0], "filename_prefix": "aethertwin_continuite"}},
  "15": {"class_type": "MaskToImage", "_meta": {"title": "Masque des mains en image"},
         "inputs": {"mask": ["13", 0]}},
  "16": {"class_type": "SaveImage", "_meta": {"title": "Masque des mains (à retoucher si besoin)"},
         "inputs": {"images": ["15", 0], "filename_prefix": "aethertwin_masque_mains"}}
}
